<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CustomerDashboardController">
   <top>
      <VBox style="-fx-background-color: #4682b4; -fx-padding: 15;">
         <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="5">
               <Label fx:id="welcomeLabel" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
               <Label fx:id="customerIdLabel" style="-fx-text-fill: #e6f3ff; -fx-font-size: 14;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #ff69b4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
         </HBox>
      </VBox>
   </top>
   
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         
         <!-- Profile Tab -->
         <Tab text="My Profile">
            <ScrollPane fitToWidth="true">
               <VBox spacing="20" style="-fx-padding: 20;">
                  <Label text="My Profile" style="-fx-text-fill: #4682b4; -fx-font-size: 20; -fx-font-weight: bold;"/>
                  
                  <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f8fdff; -fx-background-radius: 10; -fx-border-color: #4682b4; -fx-border-radius: 10;">
                     <Label text="Personal Information" style="-fx-text-fill: #4682b4; -fx-font-size: 16; -fx-font-weight: bold;"/>
                     
                     <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                           <ColumnConstraints percentWidth="50"/>
                           <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        
                        <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="profileFirstName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        
                        <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="profileLastName" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        
                        <Label text="Phone Number:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="profilePhone" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        
                        <Label text="Email Address:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="profileEmail" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        
                        <Label text="Physical Address:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="profileAddress" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        
                        <Label text="Nationality:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="profileNationality" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        
                        <Label text="Date of Birth:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="profileDob" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                     </GridPane>
                  </VBox>
                  
                  <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f8fdff; -fx-background-radius: 10; -fx-border-color: #4682b4; -fx-border-radius: 10;">
                     <Label text="Next of Kin Information" style="-fx-text-fill: #4682b4; -fx-font-size: 16; -fx-font-weight: bold;"/>
                     
                     <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                           <ColumnConstraints percentWidth="50"/>
                           <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        
                        <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="kinNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        
                        <Label text="Relationship:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="kinRelationshipField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        
                        <Label text="Phone Number:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="kinPhoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        
                        <Label text="Address:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="kinAddressField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                     </GridPane>
                  </VBox>
                  
                  <HBox spacing="20" alignment="CENTER">
                     <Button text="Update Profile" onAction="#handleUpdateProfile" style="-fx-background-color: #ff69b4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20;"/>
                     <Button text="Reset Changes" onAction="#handleResetChanges" style="-fx-background-color: #4682b4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20;"/>
                  </HBox>
               </VBox>
            </ScrollPane>
         </Tab>
         
         <!-- Accounts Tab -->
         <Tab text="My Accounts">
            <VBox spacing="20" style="-fx-padding: 20;">
               <Label text="My Accounts" style="-fx-text-fill: #4682b4; -fx-font-size: 20; -fx-font-weight: bold;"/>
               
               <TableView fx:id="accountsTable" style="-fx-border-color: #4682b4; -fx-border-radius: 5;">
                  <columns>
                     <TableColumn fx:id="accNumberCol" text="Account Number" prefWidth="150"/>
                     <TableColumn fx:id="accTypeCol" text="Account Type" prefWidth="120"/>
                     <TableColumn fx:id="balanceCol" text="Balance" prefWidth="150"/>
                  </columns>
               </TableView>
            </VBox>
         </Tab>
         
         <!-- Transactions Tab -->
         <Tab text="Transactions">
            <ScrollPane fitToWidth="true">
               <VBox spacing="20" style="-fx-padding: 20;">
                  <Label text="Banking Operations &amp; Transaction History" style="-fx-text-fill: #4682b4; -fx-font-size: 20; -fx-font-weight: bold;"/>
                  
                  <!-- Banking Operations Section -->
                  <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f8fdff; -fx-background-radius: 10; -fx-border-color: #4682b4; -fx-border-radius: 10;">
                     <Label text="Banking Operations" style="-fx-text-fill: #4682b4; -fx-font-size: 16; -fx-font-weight: bold;"/>
                     
                     <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                           <ColumnConstraints percentWidth="30"/>
                           <ColumnConstraints percentWidth="70"/>
                        </columnConstraints>
                        
                        <Label text="Select Account:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <ComboBox fx:id="operationAccountSelector" promptText="Select account" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        
                        <Label text="Operation Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <ComboBox fx:id="operationTypeComboBox" promptText="Select operation" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        
                        <Label text="Amount (BWP):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                        <TextField fx:id="operationAmountField" promptText="Enter amount" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                     </GridPane>
                     
                     <Button text="Execute Transaction" onAction="#handleTransaction" style="-fx-background-color: #ff69b4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20;"/>
                  </VBox>
                  
                  <!-- Transaction History Section -->
                  <VBox spacing="15">
                     <Label text="Transaction History" style="-fx-text-fill: #4682b4; -fx-font-size: 16; -fx-font-weight: bold;"/>
                     
                     <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Select Account:" style="-fx-text-fill: #4682b4;"/>
                        <ComboBox fx:id="accountSelector" style="-fx-pref-width: 200;"/>
                        <Button text="View Transactions" onAction="#handleViewTransactions" style="-fx-background-color: #ff69b4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                        <Button text="View All" onAction="#handleViewAllTransactions" style="-fx-background-color: #4682b4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                     </HBox>
                     
                     <TableView fx:id="transactionsTable" style="-fx-border-color: #4682b4; -fx-border-radius: 5;">
                        <columns>
                           <TableColumn fx:id="transDateCol" text="Date" prefWidth="150"/>
                           <TableColumn fx:id="transTypeCol" text="Type" prefWidth="100"/>
                           <TableColumn fx:id="transAmountCol" text="Amount" prefWidth="120"/>
                           <TableColumn fx:id="transDescCol" text="Description" prefWidth="200"/>
                        </columns>
                     </TableView>
                  </VBox>
               </VBox>
            </ScrollPane>
         </Tab>
         
         <!-- Loans Tab -->
         <Tab text="Loans">
            <VBox spacing="20" style="-fx-padding: 20;">
               <Label text="Loan Applications" style="-fx-text-fill: #4682b4; -fx-font-size: 20; -fx-font-weight: bold;"/>
               
               <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f8fdff; -fx-background-radius: 10; -fx-border-color: #4682b4; -fx-border-radius: 10;">
                  <Label text="Apply for a Loan" style="-fx-text-fill: #4682b4; -fx-font-size: 16; -fx-font-weight: bold;"/>
                  
                  <GridPane hgap="10" vgap="10">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="30"/>
                        <ColumnConstraints percentWidth="70"/>
                     </columnConstraints>
                     
                     <Label text="Loan Amount (BWP):" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                     <TextField fx:id="loanAmountField" promptText="Enter loan amount" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                     
                     <Label text="Purpose:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #4682b4;"/>
                     <TextField fx:id="loanPurposeField" promptText="Enter loan purpose" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                  </GridPane>
                  
                  <Button text="Submit Loan Application" onAction="#handleApplyForLoan" style="-fx-background-color: #ff69b4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20;"/>
               </VBox>
               
               <VBox spacing="10">
                  <Label text="My Loan Applications" style="-fx-text-fill: #4682b4; -fx-font-size: 16; -fx-font-weight: bold;"/>
                  <TableView fx:id="loansTable" style="-fx-border-color: #4682b4; -fx-border-radius: 5;">
                     <columns>
                        <TableColumn fx:id="loanIdCol" text="Loan ID" prefWidth="100"/>
                        <TableColumn fx:id="loanAmountCol" text="Amount" prefWidth="120"/>
                        <TableColumn fx:id="loanPurposeCol" text="Purpose" prefWidth="150"/>
                        <TableColumn fx:id="loanDateCol" text="Application Date" prefWidth="150"/>
                        <TableColumn fx:id="loanStatusCol" text="Status" prefWidth="100"/>
                     </columns>
                  </TableView>
               </VBox>
            </VBox>
         </Tab>
         
      </TabPane>
   </center>
</BorderPane>